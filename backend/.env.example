# Environment
ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://finsentinel:password@localhost:5432/finsentinel
REDIS_URL=redis://localhost:6379/0
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=finsentinel
INFLUXDB_BUCKET=transactions

# Plaid Configuration (Get these from https://dashboard.plaid.com/ → Team Settings → Keys)
PLAID_CLIENT_ID=your_plaid_client_id_from_dashboard
PLAID_SECRET=your_plaid_sandbox_secret_from_dashboard
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions,auth,identity,assets,liabilities
PLAID_COUNTRY_CODES=US,CA

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Blockchain
ETH_PRIVATE_KEY=your-ethereum-private-key
ETH_RPC_URL=https://polygon-rpc.com
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# External Services
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Monitoring
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=INFO

# WebSocket
WEBSOCKET_ORIGINS=http://localhost:3000,https://localhost:3000